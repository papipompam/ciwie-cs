# Environment variables declared in this file are automatically made available to Prisma and Nuxt.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# MySQL 8.4 LTS connection string
DATABASE_URL="mysql://ciwie:change_this_mysql_password@localhost:3307/ciwie_db"
MYSQL_DATABASE="ciwie_db"
MYSQL_USER="ciwie"
MYSQL_PASSWORD="change_this_mysql_password"
MYSQL_ROOT_PASSWORD="change_this_mysql_root_password"
MYSQL_PORT="3307"
PORT="3000"
FILE_STORAGE_ROOT=".data/uploads"

# Nuxt Auth secret (session encryption)
NUXT_SESSION_PASSWORD="change_this_to_at_least_32_characters_long_secret_key"
INITIAL_ACCOUNT_PASSWORD="change_this_initial_account_password"

# Demo data is opt-in because it creates known test accounts. Never enable in production.
ALLOW_DEMO_SEED="false"
SEED_DEFAULT_PASSWORD="change_this_demo_password"

# Leaflet basemap provider (public config; retain the provider's required attribution)
NUXT_PUBLIC_MAP_TILE_URL="https://tile.openstreetmap.org/{z}/{x}/{y}.png"
NUXT_PUBLIC_MAP_TILE_ATTRIBUTION='&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'

# Address geocoding provider (server-only). Set an identifying User-Agent with a contact URL/email in production.
NUXT_GEOCODING_BASE_URL="https://nominatim.openstreetmap.org"
NUXT_GEOCODING_USER_AGENT="CWIE-BRU-Supervision/1.0 (https://example.ac.th/contact)"
