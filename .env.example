NODE_ENV=development
APP_PORT=3000
APP_DOMAIN=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=ciwie
MYSQL_USER=ciwie_app
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root-me
BACKUP_ENCRYPTION_PASSWORD=replace-with-a-long-random-backup-password
BACKUP_OFFSITE_ENDPOINT=
BACKUP_OFFSITE_REGION=
BACKUP_OFFSITE_BUCKET=
BACKUP_OFFSITE_ACCESS_KEY_ID=
BACKUP_OFFSITE_SECRET_ACCESS_KEY=
BACKUP_OFFSITE_PREFIX=ciwie
# compose.production.yaml forces this to true; the backup job then requires bucket, region and credentials.
BACKUP_OFFSITE_REQUIRED=false
DATABASE_URL=mysql://ciwie_app:change-me@localhost:3306/ciwie
DATABASE_URL_CONTAINER=mysql://ciwie_app:change-me@db:3306/ciwie
MIGRATION_DATABASE_URL_CONTAINER=mysql://root:change-root-me@db:3306/ciwie
NUXT_SESSION_PASSWORD=replace-with-at-least-32-random-characters
INITIAL_ADMIN_EMAIL=admin@example.ac.th
INITIAL_ADMIN_PASSWORD=replace-on-first-login
DEMO_SEED_ENABLED=false
DEMO_SEED_TARGET=
DEMO_ADMIN_PASSWORD=
DEMO_LECTURER_PASSWORD=
DEMO_STUDENT_PASSWORD=
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=ciwie-private
MINIO_ROOT_USER=ciwie_root
MINIO_ROOT_PASSWORD=change-storage-root-secret
S3_APP_ACCESS_KEY_ID=ciwie_app
S3_APP_SECRET_ACCESS_KEY=change-storage-app-secret
S3_BACKUP_ACCESS_KEY_ID=ciwie_backup
S3_BACKUP_SECRET_ACCESS_KEY=change-storage-backup-secret
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=ciwie@example.ac.th
SMTP_USER=
SMTP_PASSWORD=
