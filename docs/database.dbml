  id char(36) [pk, not null]
  visit_id char(36) [not null]
  action varchar(64) [not null]
  snapshot json [not null]
  actor_id char(36) [not null]
  reason varchar(1000)
  created_at datetime(3) [not null, default: `CURRENT_TIMESTAMP(3)`]
  updated_at datetime(3) [not null]

  indexes {
    (visit_id, created_at)
  }
}

Table internal_notes {
  id char(36) [pk, not null]
  visit_id char(36) [not null]
  author_id char(36) [not null]
  visibility FileVisibility [not null, default: STAFF_ONLY]
  content text [not null]
  created_at datetime(3) [not null, default: `CURRENT_TIMESTAMP(3)`]
  updated_at datetime(3) [not null]

  indexes {
    (visit_id, created_at)
  }
}

Table company_requirements {
  id char(36) [pk, not null]
  visit_id char(36) [not null]
  placement_id char(36)
  category varchar(100) [not null]
  technology varchar(255)
  detail text [not null]
  author_id char(36) [not null]
  created_at datetime(3) [not null, default: `CURRENT_TIMESTAMP(3)`]
  updated_at datetime(3) [not null]

  indexes {
    (visit_id, category)
    (placement_id, created_at)
  }
}

Table evaluation_templates {
  id char(36) [pk, not null]
  code varchar(64) [not null, unique]
  subject TemplateSubject [not null]
  name varchar(255) [not null]
  is_active boolean [not null, default: true]
  created_by_id char(36) [not null]
  updated_by_id char(36) [not null]
  created_at datetime(3) [not null, default: `CURRENT_TIMESTAMP(3)`]
  updated_at datetime(3) [not null]

  indexes {
    (subject, is_active)
  }
}

Table evaluation_template_versions {
  id char(36) [pk, not null]
  template_id char(36) [not null]
  version int [not null]
  status TemplateVersionStatus [not null, default: DRAFT]
  content_hash char(64) [not null]
  published_at datetime(3)
  published_by_id char(36)
  created_at datetime(3) [not null, default: `CURRENT_TIMESTAMP(3)`]
  updated_at datetime(3) [not null]

  indexes {
    (template_id, version) [unique]
    (template_id, status)
  }
}

Table evaluation_items {
  id char(36) [pk, not null]
  template_version_id char(36) [not null]
  code varchar(64) [not null]
  label varchar(500) [not null]
  answer_type AnswerType [not null]
  required boolean [not null, default: true]
  max_score decimal(8, 2)
  weight decimal(8, 4)
  sort_order int [not null]
  created_at datetime(3) [not null, default: `CURRENT_TIMESTAMP(3)`]
  updated_at datetime(3) [not null]

  indexes {
    (template_version_id, code) [unique]
    (template_version_id, sort_order) [unique]
  }
}

Table student_evaluations {
  id char(36) [pk, not null]
  visit_student_id char(36) [not null]
  template_version_id char(36) [not null]
  template_id char(36) [not null]
  status EvaluationStatus [not null, default: DRAFT]
  version int [not null, default: 1]
  submitted_at datetime(3)
  submitted_by_id char(36)
  created_by_id char(36) [not null]
  updated_by_id char(36) [not null]
  created_at datetime(3) [not null, default: `CURRENT_TIMESTAMP(3)`]
  updated_at datetime(3) [not null]

  indexes {
    (visit_student_id, template_id) [unique]
    (status, submitted_at)
  }
}

Table student_evaluation_answers {
  id char(36) [pk, not null]
  evaluation_id char(36) [not null]
  item_id char(36) [not null]
  item_snapshot json [not null]
  score_value decimal(8, 2)
  text_value text
  boolean_value boolean
  created_at datetime(3) [not null, default: `CURRENT_TIMESTAMP(3)`]
  updated_at datetime(3) [not null]

  indexes {
    (evaluation_id, item_id) [unique]
  }
}

Table student_evaluation_versions {
  id char(36) [pk, not null]
  evaluation_id char(36) [not null]
  version int [not null]
  snapshot json [not null]
  reason varchar(1000) [not null]
  actor_id char(36) [not null]
  created_at datetime(3) [not null, default: `CURRENT_TIMESTAMP(3)`]
  updated_at datetime(3) [not null]

  indexes {
    (evaluation_id, version) [unique]
  }
}

Table organization_evaluations {
  id char(36) [pk, not null]
  visit_id char(36) [not null]
  template_version_id char(36) [not null]
  template_id char(36) [not null]
  status EvaluationStatus [not null, default: DRAFT]
  version int [not null, default: 1]
  submitted_at datetime(3)
  submitted_by_id char(36)
  created_by_id char(36) [not null]
  updated_by_id char(36) [not null]
  created_at datetime(3) [not null, default: `CURRENT_TIMESTAMP(3)`]
  updated_at datetime(3) [not null]

  indexes {
    (visit_id, template_id) [unique]
    (status, submitted_at)
  }
}

Table organization_evaluation_answers {
  id char(36) [pk, not null]
  evaluation_id char(36) [not null]
  item_id char(36) [not null]
  item_snapshot json [not null]
  score_value decimal(8, 2)
  text_value text
  boolean_value boolean
  created_at datetime(3) [not null, default: `CURRENT_TIMESTAMP(3)`]
  updated_at datetime(3) [not null]

  indexes {
    (evaluation_id, item_id) [unique]
  }
}

Table organization_evaluation_versions {
  id char(36) [pk, not null]
  evaluation_id char(36) [not null]
  version int [not null]
  snapshot json [not null]
  reason varchar(1000) [not null]
  actor_id char(36) [not null]
  created_at datetime(3) [not null, default: `CURRENT_TIMESTAMP(3)`]
  updated_at datetime(3) [not null]

  indexes {
    (evaluation_id, version) [unique]
  }
}

Table import_jobs {
  id char(36) [pk, not null]
  requested_by_id char(36) [not null]
  source_file_version_id char(36) [not null]
  kind varchar(64) [not null]
  source_checksum char(64) [not null]
  status ImportStatus [not null, default: UPLOADED]
  total_rows int [not null, default: 0]
  processed_rows int [not null, default: 0]
  failure_reason varchar(1000)
  confirmed_at datetime(3)
  created_at datetime(3) [not null, default: `CURRENT_TIMESTAMP(3)`]
  updated_at datetime(3) [not null]

  indexes {
    (requested_by_id, kind, source_checksum) [unique]
    (requested_by_id, status, created_at)
  }
}

Table import_rows {
  id char(36) [pk, not null]
  import_job_id char(36) [not null]
  row_no int [not null]
  status ImportRowStatus [not null]
  normalized_hash char(64) [not null]
  normalized_data json [not null]
  observed_version int
  errors json
  imported_entity_id char(36)
  created_at datetime(3) [not null, default: `CURRENT_TIMESTAMP(3)`]
  updated_at datetime(3) [not null]

  indexes {
    (import_job_id, row_no) [unique]
    (import_job_id, status)
  }
}

Table export_jobs {
  id char(36) [pk, not null]
  requested_by_id char(36) [not null]
  kind varchar(64) [not null]
  format varchar(16) [not null]
  filter_snapshot json [not null]
  status ExportStatus [not null, default: PENDING]
  file_version_id char(36)
  expires_at datetime(3)
  failure_reason varchar(1000)
  created_at datetime(3) [not null, default: `CURRENT_TIMESTAMP(3)`]
  updated_at datetime(3) [not null]

  indexes {
    (requested_by_id, status, created_at)
    (expires_at)
  }
}

Table notifications {
  id char(36) [pk, not null]
  recipient_id char(36) [not null]
  event_type varchar(100) [not null]
  title varchar(255) [not null]
  body varchar(1000) [not null]
  entity_type varchar(100)
  entity_id char(36)
  status NotificationStatus [not null, default: UNREAD]
  read_at datetime(3)
  created_at datetime(3) [not null, default: `CURRENT_TIMESTAMP(3)`]
  updated_at datetime(3) [not null]

  indexes {
    (recipient_id, status, created_at)
  }
}

Table outbox_messages {
  id char(36) [pk, not null]
  event_type varchar(100) [not null]
  aggregate_type varchar(100) [not null]
  aggregate_id char(36) [not null]
  dedupe_key varchar(191) [not null, unique]
  payload json [not null]
  status OutboxStatus [not null, default: PENDING]
  attempts int [not null, default: 0]
  next_attempt_at datetime(3) [not null, default: `CURRENT_TIMESTAMP(3)`]
  processed_at datetime(3)
  last_error varchar(2000)
  created_at datetime(3) [not null, default: `CURRENT_TIMESTAMP(3)`]
  updated_at datetime(3) [not null]

  indexes {
    (status, next_attempt_at)
    (aggregate_type, aggregate_id, created_at)
  }
}

Table idempotency_records {
  id char(36) [pk, not null]
  actor_id char(36) [not null]
  operation varchar(100) [not null]
  idempotency_key varchar(191) [not null]
  request_hash char(64) [not null]
  status IdempotencyStatus [not null, default: IN_PROGRESS]
  response_status int
  response_body json
  expires_at datetime(3) [not null]
  created_at datetime(3) [not null, default: `CURRENT_TIMESTAMP(3)`]
  updated_at datetime(3) [not null]

  indexes {
    (actor_id, operation, idempotency_key) [unique]
    (expires_at)
  }
}

Table expenses {
  id char(36) [pk, not null]
  visit_id char(36) [not null]
  round VisitRound [not null]
  travel_days smallint unsigned [not null]
  travel_amount decimal(12, 2) [not null, default: 0]
  lodging_amount decimal(12, 2) [not null, default: 0]
  meal_amount decimal(12, 2) [not null, default: 0]
  total_amount decimal(12, 2) [not null, default: 0]
  note varchar(1000)
  version int [not null, default: 1]
  created_by_id char(36) [not null]
  updated_by_id char(36) [not null]
  created_at datetime(3) [not null, default: `CURRENT_TIMESTAMP(3)`]
  updated_at datetime(3) [not null]

  indexes {
    (visit_id, round, created_at)
  }
}

Table expense_versions {
  id char(36) [pk, not null]
  expense_id char(36) [not null]
  version int [not null]
  snapshot json [not null]
  reason varchar(1000) [not null]
  actor_id char(36) [not null]
  created_at datetime(3) [not null, default: `CURRENT_TIMESTAMP(3)`]
  updated_at datetime(3) [not null]

  indexes {
    (expense_id, version) [unique]
  }
}

Table audit_logs {
  id char(36) [pk, not null]
  actor_id char(36)
  action varchar(100) [not null]
  entity_type varchar(100) [not null]
  entity_id char(36) [not null]
  request_id varchar(100) [not null]
  reason varchar(1000)
  before_data json
  after_data json
  ip_address varchar(45)
  created_at datetime(3) [not null, default: `CURRENT_TIMESTAMP(3)`]

  indexes {
    (entity_type, entity_id, created_at)
    (actor_id, created_at)
    (request_id)
  }
}

