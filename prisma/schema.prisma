  createdAt           DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt           DateTime     @updatedAt @map("updated_at") @db.DateTime(3)
  sourceFileVersion   FileVersion  @relation(fields: [sourceFileVersionId], references: [id], onDelete: Restrict)
  rows                ImportRow[]

  @@unique([requestedById, kind, sourceChecksum])
  @@index([requestedById, status, createdAt])
  @@map("import_jobs")
}

model ImportRow {
  id               String          @id @default(uuid()) @db.Char(36)
  importJobId      String          @map("import_job_id") @db.Char(36)
  rowNo            Int             @map("row_no")
  status           ImportRowStatus
  normalizedHash   String          @map("normalized_hash") @db.Char(64)
  normalizedData   Json            @map("normalized_data")
  observedVersion  Int?            @map("observed_version")
  errors           Json?
  importedEntityId String?         @map("imported_entity_id") @db.Char(36)
  createdAt        DateTime        @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.DateTime(3)
  importJob        ImportJob       @relation(fields: [importJobId], references: [id], onDelete: Restrict)

  @@unique([importJobId, rowNo])
  @@index([importJobId, status])
  @@map("import_rows")
}

model ExportJob {
  id             String       @id @default(uuid()) @db.Char(36)
  requestedById  String       @map("requested_by_id") @db.Char(36)
  kind           String       @db.VarChar(64)
  format         String       @db.VarChar(16)
  filterSnapshot Json         @map("filter_snapshot")
  status         ExportStatus @default(PENDING)
  fileVersionId  String?      @map("file_version_id") @db.Char(36)
  expiresAt      DateTime?    @map("expires_at") @db.DateTime(3)
  failureReason  String?      @map("failure_reason") @db.VarChar(1000)
  createdAt      DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.DateTime(3)
  fileVersion    FileVersion? @relation(fields: [fileVersionId], references: [id], onDelete: Restrict)

  @@index([requestedById, status, createdAt])
  @@index([expiresAt])
  @@map("export_jobs")
}

model Notification {
  id          String             @id @default(uuid()) @db.Char(36)
  recipientId String             @map("recipient_id") @db.Char(36)
  eventType   String             @map("event_type") @db.VarChar(100)
  title       String             @db.VarChar(255)
  body        String             @db.VarChar(1000)
  entityType  String?            @map("entity_type") @db.VarChar(100)
  entityId    String?            @map("entity_id") @db.Char(36)
  status      NotificationStatus @default(UNREAD)
  readAt      DateTime?          @map("read_at") @db.DateTime(3)
  createdAt   DateTime           @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.DateTime(3)
  recipient   User               @relation(fields: [recipientId], references: [id], onDelete: Restrict)

  @@index([recipientId, status, createdAt])
  @@map("notifications")
}

model OutboxMessage {
  id            String       @id @default(uuid()) @db.Char(36)
  eventType     String       @map("event_type") @db.VarChar(100)
  aggregateType String       @map("aggregate_type") @db.VarChar(100)
  aggregateId   String       @map("aggregate_id") @db.Char(36)
  dedupeKey     String       @unique @map("dedupe_key") @db.VarChar(191)
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  nextAttemptAt DateTime     @default(now()) @map("next_attempt_at") @db.DateTime(3)
  processedAt   DateTime?    @map("processed_at") @db.DateTime(3)
  lastError     String?      @map("last_error") @db.VarChar(2000)
  createdAt     DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.DateTime(3)

  @@index([status, nextAttemptAt])
  @@index([aggregateType, aggregateId, createdAt])
  @@map("outbox_messages")
}

model IdempotencyRecord {
  id             String            @id @default(uuid()) @db.Char(36)
  actorId        String            @map("actor_id") @db.Char(36)
  operation      String            @db.VarChar(100)
  idempotencyKey String            @map("idempotency_key") @db.VarChar(191)
  requestHash    String            @map("request_hash") @db.Char(64)
  status         IdempotencyStatus @default(IN_PROGRESS)
  responseStatus Int?              @map("response_status")
  responseBody   Json?             @map("response_body")
  expiresAt      DateTime          @map("expires_at") @db.DateTime(3)
  createdAt      DateTime          @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.DateTime(3)

  @@unique([actorId, operation, idempotencyKey])
  @@index([expiresAt])
  @@map("idempotency_records")
}

model Expense {
  id            String           @id @default(uuid()) @db.Char(36)
  visitId       String           @map("visit_id") @db.Char(36)
  round         VisitRound
  travelDays    Int              @map("travel_days") @db.UnsignedSmallInt
  travelAmount  Decimal          @default(0) @map("travel_amount") @db.Decimal(12, 2)
  lodgingAmount Decimal          @default(0) @map("lodging_amount") @db.Decimal(12, 2)
  mealAmount    Decimal          @default(0) @map("meal_amount") @db.Decimal(12, 2)
  totalAmount   Decimal          @default(0) @map("total_amount") @db.Decimal(12, 2)
  note          String?          @db.VarChar(1000)
  version       Int              @default(1)
  createdById   String           @map("created_by_id") @db.Char(36)
  updatedById   String           @map("updated_by_id") @db.Char(36)
  createdAt     DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.DateTime(3)
  visit         SupervisionVisit @relation(fields: [visitId], references: [id], onDelete: Restrict)
  versions      ExpenseVersion[]

  @@index([visitId, round, createdAt])
  @@map("expenses")
}

model ExpenseVersion {
  id        String   @id @default(uuid()) @db.Char(36)
  expenseId String   @map("expense_id") @db.Char(36)
  version   Int
  snapshot  Json
  reason    String   @db.VarChar(1000)
  actorId   String   @map("actor_id") @db.Char(36)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  expense   Expense  @relation(fields: [expenseId], references: [id], onDelete: Restrict)

  @@unique([expenseId, version])
  @@map("expense_versions")
}

/// Append-only: the initial MySQL migration rejects UPDATE and DELETE with triggers.
model AuditLog {
  id         String   @id @default(uuid()) @db.Char(36)
  actorId    String?  @map("actor_id") @db.Char(36)
  action     String   @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(100)
  entityId   String   @map("entity_id") @db.Char(36)
  requestId  String   @map("request_id") @db.VarChar(100)
  reason     String?  @db.VarChar(1000)
  beforeData Json?    @map("before_data")
  afterData  Json?    @map("after_data")
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@index([requestId])
  @@map("audit_logs")
}
