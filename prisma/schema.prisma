generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  LECTURER
  ADMIN
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum TokenStatus {
  ACTIVE
  USED
  REVOKED
}

enum ApplicationStatus {
  SUBMITTED
  WAITING_RESPONSE
  INTERVIEW_PENDING
  PRELIMINARY_ACCEPTED
  REJECTED
  CANCELLED
}

enum DocumentRequestStatus {
  REQUESTED
  IN_PROGRESS
  READY_TO_SEND
  CANCELLED
}

enum DocumentBatchStatus {
  DRAFT
  READY_TO_SEND
  SENT
  CLOSED
  CANCELLED
}

enum DeliveryStatus {
  ASSIGNED
  SENT
  WAITING_RESPONSE
  RESPONSE_RECEIVED
}

enum DeliveryOwnerType {
  STUDENT
  LECTURER
}

enum ResponseStatus {
  DRAFT
  PENDING_REVIEW
  CONFIRMED
}

enum ResponseResult {
  ACCEPTED
  DECLINED
}

enum PlacementStatus {
  ACTIVE
  REVERSED
}

enum VisitRound {
  ROUND_1
  ROUND_2
}

enum VisitPeriod {
  MORNING
  AFTERNOON
  FULL_DAY
}

enum VisitStatus {
  SCHEDULED
  POSTPONED
  COMPLETED
  CANCELLED
}

enum AcknowledgementStatus {
  PENDING
  ACKNOWLEDGED
}

enum SupervisionOutcome {
  COMPLETED
  ABSENT
  MAKEUP_REQUIRED
}

enum TemplateSubject {
  STUDENT
  ORGANIZATION
}

enum TemplateVersionStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

enum AnswerType {
  SCORE
  TEXT
  BOOLEAN
}

enum EvaluationStatus {
  DRAFT
  SUBMITTED
}

enum FileScanStatus {
  UPLOADED
  PENDING_SCAN
  CLEAN
  REJECTED
}

enum FileVisibility {
  PRIVATE
  STUDENT_VISIBLE
  STAFF_ONLY
}

enum ImportStatus {
  UPLOADED
  SCANNING
  PREVIEW_READY
  CONFIRMING
  COMPLETED
  FAILED
}

enum ImportRowStatus {
  NEW
  UNCHANGED
  CONFLICT
  INVALID
  IMPORTED
}

enum ExportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  EXPIRED
}

enum NotificationStatus {
  UNREAD
  READ
}

enum OutboxStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

enum IdempotencyStatus {
  IN_PROGRESS
  SUCCEEDED
  FAILED
}

model User {
  id                   String               @id @default(uuid()) @db.Char(36)
  identifier           String               @db.VarChar(191)
  normalizedIdentifier String               @unique @map("normalized_identifier") @db.VarChar(191)
  email                String               @db.VarChar(320)
  normalizedEmail      String               @unique @map("normalized_email") @db.VarChar(320)
  passwordHash         String               @map("password_hash") @db.VarChar(255)
  role                 UserRole
  status               UserStatus           @default(PENDING)
  sessionVersion       Int                  @default(1) @map("session_version")
  mustChangePassword   Boolean              @default(true) @map("must_change_password")
  lastLoginAt          DateTime?            @map("last_login_at") @db.DateTime(3)
  createdAt            DateTime             @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt            DateTime             @updatedAt @map("updated_at") @db.DateTime(3)
  studentProfile       StudentProfile?
  lecturerProfile      LecturerProfile?
  activationCodes      ActivationCode[]
  passwordResetTokens  PasswordResetToken[]
  sessions             UserSession[]
  notifications        Notification[]

  @@index([role, status])
  @@map("users")
}

model ActivationCode {
  id        String      @id @default(uuid()) @db.Char(36)
  userId    String      @map("user_id") @db.Char(36)
  tokenHash String      @unique @map("token_hash") @db.Char(64)
  status    TokenStatus @default(ACTIVE)
  expiresAt DateTime    @map("expires_at") @db.DateTime(3)
  usedAt    DateTime?   @map("used_at") @db.DateTime(3)
  revokedAt DateTime?   @map("revoked_at") @db.DateTime(3)
  createdAt DateTime    @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime    @updatedAt @map("updated_at") @db.DateTime(3)
  user      User        @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, expiresAt])
  @@map("activation_codes")
}

model PasswordResetToken {
  id        String      @id @default(uuid()) @db.Char(36)
  userId    String      @map("user_id") @db.Char(36)
  tokenHash String      @unique @map("token_hash") @db.Char(64)
  status    TokenStatus @default(ACTIVE)
  expiresAt DateTime    @map("expires_at") @db.DateTime(3)
  usedAt    DateTime?   @map("used_at") @db.DateTime(3)
  revokedAt DateTime?   @map("revoked_at") @db.DateTime(3)
  createdAt DateTime    @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime    @updatedAt @map("updated_at") @db.DateTime(3)
  user      User        @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model UserSession {
  id          String    @id @default(uuid()) @db.Char(36)
  userId      String    @map("user_id") @db.Char(36)
  sessionHash String    @unique @map("session_hash") @db.Char(64)
  expiresAt   DateTime  @map("expires_at") @db.DateTime(3)
  revokedAt   DateTime? @map("revoked_at") @db.DateTime(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  user        User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, revokedAt, expiresAt])
  @@map("user_sessions")
}

model StudentProfile {
  id          String                  @id @default(uuid()) @db.Char(36)
  userId      String                  @unique @map("user_id") @db.Char(36)
  studentCode String                  @unique @map("student_code") @db.VarChar(32)
  firstNameTh String                  @map("first_name_th") @db.VarChar(100)
  lastNameTh  String                  @map("last_name_th") @db.VarChar(100)
  phone       String?                 @db.VarChar(32)
  createdAt   DateTime                @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime                @updatedAt @map("updated_at") @db.DateTime(3)
  user        User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  enrollments StudentTermEnrollment[]

  @@index([lastNameTh, firstNameTh])
  @@map("student_profiles")
}

model LecturerProfile {
  id               String          @id @default(uuid()) @db.Char(36)
  userId           String          @unique @map("user_id") @db.Char(36)
  employeeCode     String?         @unique @map("employee_code") @db.VarChar(32)
  firstNameTh      String          @map("first_name_th") @db.VarChar(100)
  lastNameTh       String          @map("last_name_th") @db.VarChar(100)
  phone            String?         @db.VarChar(32)
  createdAt        DateTime        @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.DateTime(3)
  user             User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  visitAssignments VisitLecturer[]

  @@index([lastNameTh, firstNameTh])
  @@map("lecturer_profiles")
}

model CoopTerm {
  id           String                  @id @default(uuid()) @db.Char(36)
  academicYear Int                     @map("academic_year")
  semester     Int
  name         String                  @db.VarChar(100)
  startsOn     DateTime                @map("starts_on") @db.Date
  endsOn       DateTime                @map("ends_on") @db.Date
  isActive     Boolean                 @default(false) @map("is_active")
  createdAt    DateTime                @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime                @updatedAt @map("updated_at") @db.DateTime(3)
  enrollments  StudentTermEnrollment[]
  applications Application[]
  requests     DocumentRequest[]
  batches      DocumentBatch[]
  visits       SupervisionVisit[]

  @@unique([academicYear, semester])
  @@index([isActive, startsOn])
  @@map("coop_terms")
}

model StudentTermEnrollment {
  id            String                     @id @default(uuid()) @db.Char(36)
  studentId     String                     @map("student_id") @db.Char(36)
  coopTermId    String                     @map("coop_term_id") @db.Char(36)
  version       Int                        @default(1)
  createdAt     DateTime                   @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime                   @updatedAt @map("updated_at") @db.DateTime(3)
  student       StudentProfile             @relation(fields: [studentId], references: [id], onDelete: Restrict)
  coopTerm      CoopTerm                   @relation(fields: [coopTermId], references: [id], onDelete: Restrict)
  applications  Application[]
  requests      DocumentRequest[]
  batchMembers  DocumentBatchMember[]
  batchSlots    DocumentBatchStudentSlot[]
  placement     Placement?
  visitStudents VisitStudent[]

  @@unique([studentId, coopTermId])
  @@unique([id, coopTermId])
  @@index([coopTermId, createdAt])
  @@map("student_term_enrollments")
}

model Organization {
  id             String                     @id @default(uuid()) @db.Char(36)
  nameTh         String                     @map("name_th") @db.VarChar(255)
  nameEn         String?                    @map("name_en") @db.VarChar(255)
  normalizedName String                     @map("normalized_name") @db.VarChar(255)
  taxId          String?                    @unique @map("tax_id") @db.VarChar(32)
  isActive       Boolean                    @default(true) @map("is_active")
  createdById    String                     @map("created_by_id") @db.Char(36)
  updatedById    String                     @map("updated_by_id") @db.Char(36)
  createdAt      DateTime                   @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime                   @updatedAt @map("updated_at") @db.DateTime(3)
  workSites      WorkSite[]
  contacts       OrganizationContact[]
  aliases        OrganizationAlias[]
  mergeSources   OrganizationMergeHistory[] @relation("MergeSource")
  mergeTargets   OrganizationMergeHistory[] @relation("MergeTarget")

  @@index([normalizedName])
  @@index([isActive, nameTh])
  @@map("organizations")
}

model WorkSite {
  id             String                @id @default(uuid()) @db.Char(36)
  organizationId String                @map("organization_id") @db.Char(36)
  name           String                @db.VarChar(255)
  normalizedName String                @map("normalized_name") @db.VarChar(255)
  addressLine    String                @map("address_line") @db.VarChar(500)
  province       String                @db.VarChar(100)
  region         String                @db.VarChar(100)
  postalCode     String?               @map("postal_code") @db.VarChar(10)
  isActive       Boolean               @default(true) @map("is_active")
  createdAt      DateTime              @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime              @updatedAt @map("updated_at") @db.DateTime(3)
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  contacts       OrganizationContact[]
  applications   Application[]
  requests       DocumentRequest[]
  batches        DocumentBatch[]
  placements     Placement[]
  visits         SupervisionVisit[]

  @@unique([organizationId, normalizedName])
  @@index([province, normalizedName])
  @@index([region, province])
  @@map("work_sites")
}

model OrganizationContact {
  id             String        @id @default(uuid()) @db.Char(36)
  organizationId String        @map("organization_id") @db.Char(36)
  workSiteId     String?       @map("work_site_id") @db.Char(36)
  name           String        @db.VarChar(200)
  position       String?       @db.VarChar(150)
  email          String?       @db.VarChar(320)
  phone          String?       @db.VarChar(32)
  isActive       Boolean       @default(true) @map("is_active")
  createdAt      DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.DateTime(3)
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  workSite       WorkSite?     @relation(fields: [workSiteId], references: [id], onDelete: Restrict)
  applications   Application[]

  @@index([organizationId, isActive])
  @@index([workSiteId, isActive])
  @@map("organization_contacts")
}

model OrganizationAlias {
  id              String       @id @default(uuid()) @db.Char(36)
  organizationId  String       @map("organization_id") @db.Char(36)
  normalizedAlias String       @unique @map("normalized_alias") @db.VarChar(255)
  displayAlias    String       @map("display_alias") @db.VarChar(255)
  createdAt       DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.DateTime(3)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@map("organization_aliases")
}

model OrganizationMergeHistory {
  id                   String       @id @default(uuid()) @db.Char(36)
  sourceOrganizationId String       @map("source_organization_id") @db.Char(36)
  targetOrganizationId String       @map("target_organization_id") @db.Char(36)
  actorId              String       @map("actor_id") @db.Char(36)
  reason               String       @db.VarChar(1000)
  sourceSnapshot       Json         @map("source_snapshot")
  createdAt            DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt            DateTime     @updatedAt @map("updated_at") @db.DateTime(3)
  sourceOrganization   Organization @relation("MergeSource", fields: [sourceOrganizationId], references: [id], onDelete: Restrict)
  targetOrganization   Organization @relation("MergeTarget", fields: [targetOrganizationId], references: [id], onDelete: Restrict)

  @@index([sourceOrganizationId, createdAt])
  @@index([targetOrganizationId, createdAt])
  @@map("organization_merge_history")
}

model Application {
  id               String                     @id @default(uuid()) @db.Char(36)
  studentTermId    String                     @map("student_term_id") @db.Char(36)
  coopTermId       String                     @map("coop_term_id") @db.Char(36)
  workSiteId       String                     @map("work_site_id") @db.Char(36)
  contactId        String?                    @map("contact_id") @db.Char(36)
  contactSnapshot  Json?                      @map("contact_snapshot")
  status           ApplicationStatus          @default(SUBMITTED)
  positionTitle    String?                    @map("position_title") @db.VarChar(255)
  appliedAt        DateTime                   @default(now()) @map("applied_at") @db.DateTime(3)
  version          Int                        @default(1)
  createdById      String                     @map("created_by_id") @db.Char(36)
  updatedById      String                     @map("updated_by_id") @db.Char(36)
  createdAt        DateTime                   @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime                   @updatedAt @map("updated_at") @db.DateTime(3)
  studentTerm      StudentTermEnrollment      @relation(fields: [studentTermId], references: [id], onDelete: Restrict)
  coopTerm         CoopTerm                   @relation(fields: [coopTermId], references: [id], onDelete: Restrict)
  workSite         WorkSite                   @relation(fields: [workSiteId], references: [id], onDelete: Restrict)
  contact          OrganizationContact?       @relation(fields: [contactId], references: [id], onDelete: Restrict)
  histories        ApplicationStatusHistory[]
  evidenceFiles    ApplicationEvidenceFile[]
  documentRequests DocumentRequest[]

  @@unique([id, coopTermId, workSiteId])
  @@index([studentTermId, status])
  @@index([workSiteId, status, appliedAt])
  @@index([contactId])
  @@map("applications")
}

model ApplicationStatusHistory {
  id            String             @id @default(uuid()) @db.Char(36)
  applicationId String             @map("application_id") @db.Char(36)
  fromStatus    ApplicationStatus? @map("from_status")
  toStatus      ApplicationStatus  @map("to_status")
  actorId       String             @map("actor_id") @db.Char(36)
  reason        String?            @db.VarChar(1000)
  snapshot      Json?
  createdAt     DateTime           @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.DateTime(3)
  application   Application        @relation(fields: [applicationId], references: [id], onDelete: Restrict)

  @@index([applicationId, createdAt])
  @@map("application_status_history")
}

model StoredFile {
  id               String         @id @default(uuid()) @db.Char(36)
  originalFilename String         @map("original_filename") @db.VarChar(255)
  createdById      String         @map("created_by_id") @db.Char(36)
  visibility       FileVisibility @default(PRIVATE)
  createdAt        DateTime       @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.DateTime(3)
  versions         FileVersion[]

  @@index([createdById, createdAt])
  @@map("files")
}

model FileVersion {
  id                  String                    @id @default(uuid()) @db.Char(36)
  fileId              String                    @map("file_id") @db.Char(36)
  revision            Int
  objectKey           String                    @unique @map("object_key") @db.VarChar(512)
  checksumSha256      String                    @map("checksum_sha256") @db.Char(64)
  mimeType            String                    @map("mime_type") @db.VarChar(255)
  extension           String                    @db.VarChar(16)
  sizeBytes           BigInt                    @map("size_bytes") @db.UnsignedBigInt
  scanStatus          FileScanStatus            @default(UPLOADED) @map("scan_status")
  scanReason          String?                   @map("scan_reason") @db.VarChar(500)
  createdById         String                    @map("created_by_id") @db.Char(36)
  createdAt           DateTime                  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt           DateTime                  @updatedAt @map("updated_at") @db.DateTime(3)
  file                StoredFile                @relation(fields: [fileId], references: [id], onDelete: Restrict)
  applicationEvidence ApplicationEvidenceFile[]
  documentVersions    DocumentVersion[]
  deliveryEvidence    DeliveryEvidenceFile[]
  responseForms       ResponseForm[]
  importJobs          ImportJob[]
  exportJobs          ExportJob[]

  @@unique([fileId, revision])
  @@index([checksumSha256])
  @@index([scanStatus, createdAt])
  @@map("file_versions")
}

model ApplicationEvidenceFile {
  id            String         @id @default(uuid()) @db.Char(36)
  applicationId String         @map("application_id") @db.Char(36)
  fileVersionId String         @map("file_version_id") @db.Char(36)
  visibility    FileVisibility @default(STUDENT_VISIBLE)
  createdAt     DateTime       @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.DateTime(3)
  application   Application    @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  fileVersion   FileVersion    @relation(fields: [fileVersionId], references: [id], onDelete: Restrict)

  @@unique([applicationId, fileVersionId])
  @@map("application_evidence_files")
}

model DocumentRequest {
  id            String                @id @default(uuid()) @db.Char(36)
  studentTermId String                @map("student_term_id") @db.Char(36)
  applicationId String                @map("application_id") @db.Char(36)
  coopTermId    String                @map("coop_term_id") @db.Char(36)
  workSiteId    String                @map("work_site_id") @db.Char(36)
  status        DocumentRequestStatus @default(REQUESTED)
  requestedAt   DateTime              @default(now()) @map("requested_at") @db.DateTime(3)
  createdById   String                @map("created_by_id") @db.Char(36)
  updatedById   String                @map("updated_by_id") @db.Char(36)
  createdAt     DateTime              @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime              @updatedAt @map("updated_at") @db.DateTime(3)
  studentTerm   StudentTermEnrollment @relation(fields: [studentTermId], references: [id], onDelete: Restrict)
  application   Application           @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  coopTerm      CoopTerm              @relation(fields: [coopTermId], references: [id], onDelete: Restrict)
  workSite      WorkSite              @relation(fields: [workSiteId], references: [id], onDelete: Restrict)
  batchMember   DocumentBatchMember?

  @@unique([id, studentTermId, coopTermId, workSiteId])
  @@index([coopTermId, workSiteId, status])
  @@index([studentTermId, status])
  @@map("document_requests")
}

model DocumentBatch {
  id              String                     @id @default(uuid()) @db.Char(36)
  coopTermId      String                     @map("coop_term_id") @db.Char(36)
  workSiteId      String                     @map("work_site_id") @db.Char(36)
  status          DocumentBatchStatus        @default(DRAFT)
  documentType    String                     @map("document_type") @db.VarChar(64)
  documentNo      String?                    @map("document_no") @db.VarChar(100)
  documentYear    Int?                       @map("document_year")
  documentDate    DateTime?                  @map("document_date") @db.Date
  lockVersion     Int                        @default(1) @map("lock_version")
  createdById     String                     @map("created_by_id") @db.Char(36)
  updatedById     String                     @map("updated_by_id") @db.Char(36)
  createdAt       DateTime                   @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime                   @updatedAt @map("updated_at") @db.DateTime(3)
  coopTerm        CoopTerm                   @relation(fields: [coopTermId], references: [id], onDelete: Restrict)
  workSite        WorkSite                   @relation(fields: [workSiteId], references: [id], onDelete: Restrict)
  members         DocumentBatchMember[]
  studentSlots    DocumentBatchStudentSlot[]
  versions        DocumentVersion[]
  deliveries      Delivery[]
  responseForms   ResponseForm[]
  responseResults ResponseStudentResult[]

  @@unique([id, coopTermId, workSiteId])
  @@unique([documentYear, documentType, documentNo])
  @@index([coopTermId, workSiteId, status])
  @@map("document_batches")
}

model DocumentBatchMember {
  id              String                    @id @default(uuid()) @db.Char(36)
  batchId         String                    @map("batch_id") @db.Char(36)
  requestId       String                    @unique @map("request_id") @db.Char(36)
  studentTermId   String                    @map("student_term_id") @db.Char(36)
  coopTermId      String                    @map("coop_term_id") @db.Char(36)
  workSiteId      String                    @map("work_site_id") @db.Char(36)
  snapshot        Json
  createdAt       DateTime                  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime                  @updatedAt @map("updated_at") @db.DateTime(3)
  batch           DocumentBatch             @relation(fields: [batchId], references: [id], onDelete: Restrict)
  request         DocumentRequest           @relation(fields: [requestId], references: [id], onDelete: Restrict)
  studentTerm     StudentTermEnrollment     @relation(fields: [studentTermId], references: [id], onDelete: Restrict)
  responseResults ResponseStudentResult[]
  activeSlot      DocumentBatchStudentSlot?

  @@unique([batchId, studentTermId])
  @@unique([id, batchId])
  @@unique([id, batchId, studentTermId, coopTermId, workSiteId])
  @@index([coopTermId, workSiteId, studentTermId])
  @@map("document_batch_members")
}

model DocumentBatchStudentSlot {
  id            String                @id @default(uuid()) @db.Char(36)
  batchMemberId String                @unique @map("batch_member_id") @db.Char(36)
  batchId       String                @map("batch_id") @db.Char(36)
  studentTermId String                @map("student_term_id") @db.Char(36)
  coopTermId    String                @map("coop_term_id") @db.Char(36)
  workSiteId    String                @map("work_site_id") @db.Char(36)
  createdAt     DateTime              @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime              @updatedAt @map("updated_at") @db.DateTime(3)
  batchMember   DocumentBatchMember   @relation(fields: [batchMemberId], references: [id], onDelete: Restrict)
  batch         DocumentBatch         @relation(fields: [batchId], references: [id], onDelete: Restrict)
  studentTerm   StudentTermEnrollment @relation(fields: [studentTermId], references: [id], onDelete: Restrict)

  @@unique([studentTermId, coopTermId, workSiteId])
  @@index([batchId, studentTermId])
  @@map("document_batch_student_slots")
}

model DocumentVersion {
  id            String        @id @default(uuid()) @db.Char(36)
  batchId       String        @map("batch_id") @db.Char(36)
  revision      Int
  kind          String        @db.VarChar(64)
  fileVersionId String        @map("file_version_id") @db.Char(36)
  createdById   String        @map("created_by_id") @db.Char(36)
  createdAt     DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.DateTime(3)
  batch         DocumentBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  fileVersion   FileVersion   @relation(fields: [fileVersionId], references: [id], onDelete: Restrict)

  @@unique([batchId, kind, revision])
